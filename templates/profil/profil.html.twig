{% extends 'base.html.twig' %}

{% block title %}Profil - FishManager{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    
{% endblock %}

{% block body %}
    <div id="fish-container"></div>

    <div class="profile-wrapper">
        <div class="profile-back-container">
            <a href="/" class="back-button">
                <i class="fas fa-arrow-left"></i>
                Retour au tableau de bord
            </a>
        </div>

        <div class="profile-card">
            <!-- En-tête du profil -->
            <div class="profile-header">
                <div class="profile-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <h1 class="profile-name">{{ user.firstName }} {{ user.lastName }}</h1>
            </div>

            <!-- Sections du profil -->
            <div class="profile-sections">
                <!-- Binôme -->
                <div class="profile-section">
                    <h3 class="profile-section-title">
                        <i class="fas fa-users"></i>
                        Binôme
                    </h3>
                    <div class="section-content">
                        {{ user.binome }}
                    </div>
                </div>

                <!-- Dates de préemption -->
                <div class="profile-section">
                    <h3 class="profile-section-title">
                        <i class="fas fa-calendar"></i>
                        Dates de préemption
                    </h3>
                    <div class="section-content">
                        <div class="date-range">
                            du <span class="date">{{ user.dateDebut|date('d/m/y') }}</span> au <span class="date">{{ user.dateFin|date('d/m/y') }}</span>
                        </div>
                    </div>
                </div>

                <!-- Dernier repas -->
                <div class="profile-section">
                    <h3 class="profile-section-title">
                        <i class="fas fa-utensils"></i>
                        Dernier repas
                    </h3>
                    <div class="section-content">
                        {{ user.dernierRepas|date('d/m/y') }}
                    </div>
                    <div class="section-actions">
                        <button class="btn-action btn-action-primary" onclick="alert('Fonctionnalité à implémenter')">
                            Ajouter un repas
                        </button>
                    </div>
                </div>

                <!-- À faire -->
                <div class="profile-section">
                    <h3 class="profile-section-title">
                        <i class="fas fa-tasks"></i>
                        À faire
                    </h3>
                    {% if user.taches|length > 0 %}
                        <ul class="todo-list">
                            {% for tache in user.taches %}
                                <li class="todo-item">
                                    <input type="checkbox" class="todo-checkbox">
                                    <span>{{ tache }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="empty-message">Aucune tâche pour le moment</p>
                    {% endif %}
                    <div class="section-actions">
                        <button class="btn-action btn-action-secondary" onclick="alert('Fonctionnalité à implémenter')">
                            Ajouter un tâche
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
{% endblock %}

{% block jsbottom %}
    <script>
        const container = document.getElementById('fish-container');

        function createFish() {
            const fish = document.createElement('div');
            fish.classList.add('fish');

            // 1. Position Verticale aléatoire (entre 5% et 95% de la hauteur)
            const topPosition = Math.random() * 90 + 5;
            fish.style.top = topPosition + '%';

            // 2. Taille aléatoire (effet de profondeur)
            const scale = Math.random() * 0.8 + 0.5; // Entre 0.5 et 1.3
            
            // 3. Vitesse (durée de traversée)
            const duration = (Math.random() * 10 + 15) / scale; 
            
            // 4. Direction (Gauche vers Droite OU Droite vers Gauche)
            const startRight = Math.random() > 0.5;
            
            if (startRight) {
                // Part de la droite, nage vers la gauche
                fish.style.left = '110%'; // Hors écran
                fish.classList.add('swim-left'); 
                fish.style.transform = `scale(${scale}) scaleX(1)`; // Normal (regarde à gauche)

                const animation = fish.animate([
                    { left: '110%' },
                    { left: '-10%' }
                ], {
                    duration: duration * 1000,
                    easing: 'linear',
                    iterations: 1
                });
                animation.onfinish = () => fish.remove();

            } else {
                // Part de la gauche, nage vers la droite
                fish.style.left = '-10%'; // Hors écran
                fish.classList.add('swim-right');
                fish.style.transform = `scale(${scale}) scaleX(-1)`; // Miroir (regarde à droite)
                
                const animation = fish.animate([
                    { left: '-10%' },
                    { left: '110%' }
                ], {
                    duration: duration * 1000,
                    easing: 'linear',
                    iterations: 1
                });
                animation.onfinish = () => fish.remove();
            }

            container.appendChild(fish);
        }

        // Créer un poisson toutes les 2-4 secondes
        setInterval(() => {
            createFish();
        }, Math.random() * 2000 + 2000);
    </script>
{% endblock %}
